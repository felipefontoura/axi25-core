{
  "name": "@axi25/core",
  "version": "2.0.0",
  "description": "AXI25 core — a harness-agnostic wiki-llm vault OS (skills + contract) for Claude Code, OpenAI Codex, OpenCode, and Pi. Projects into any vault; single source of truth.",
  "type": "module",
  "bin": {
    "axi25": "bin/axi25.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "wire": "node bin/axi25.mjs wire",
    "lint": "markdownlint-cli2 \"**/*.md\"",
    "test": "node .ci/verify.mjs"
  },
  "files": [
    "bin/",
    "skills/",
    "references/",
    "docs/",
    "AGENTS.md",
    "CLAUDE.md",
    ".markdownlint-cli2.jsonc",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "second-brain",
    "zettelkasten",
    "wiki-llm",
    "obsidian",
    "claude-code",
    "codex",
    "opencode",
    "agent-skills",
    "agents-md",
    "knowledge-management",
    "axi25"
  ],
  "author": "Felipe Fontoura",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipefontoura/axi25-core.git"
  },
  "homepage": "https://github.com/felipefontoura/axi25-core#readme",
  "bugs": {
    "url": "https://github.com/felipefontoura/axi25-core/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
